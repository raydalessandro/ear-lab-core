{
  "name": "ear-lab-core",
  "version": "0.1.0",
  "private": true,
  "description": "EAR Lab Core – Tipi, Schemi Zod, Utils e Logica condivisa",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
